# Copy to .env.local and replace with credentials for your services.
# MongoDB Atlas runtime connection (server only; never add NEXT_PUBLIC_ to these values).
MONGODB_URI=mongodb+srv://mdkaif92398swn:kaif786@cluster0.eskov.mongodb.net/
MONGODB_DB=glorious_exams

# Temporary one-time migration source only. Remove these after export and runtime cutover.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Older projects may use the anon key instead; set this if you do not have a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only one-time export key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Server-only shared teacher login password. Each approved teacher uses this same value.
TEACHER_LOGIN_PASSWORD=786
# Generate a unique random value for signing teacher sessions.
TEACHER_SESSION_SECRET=GENERATE_A_RANDOM_SECRET
# Optional public QR image URL supplied by the school. If empty, the app expects
# public/payments/phonepe-payment-qr.jpeg. Payment is manually verified.
NEXT_PUBLIC_PAYMENT_QR_IMAGE_URL=
NEXT_PUBLIC_PAYMENT_UPI_ID=
